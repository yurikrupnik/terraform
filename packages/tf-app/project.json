{
  "name": "tf-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/tf-app/modules/app",
  "targets": {
    "initialize": {
      "executor": "@nx-extend/terraform:init",
      "options": {
        "ciMode": true,
        "upgrade": false,
        "migrateState": false
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": { "root": "packages/tf-app/envs/dev" },
        "prod": { "root": "packages/tf-app/envs/prod" }
      }
    },
    "providers": {
      "executor": "@nx-extend/terraform:providers",
      "options": {
        "ciMode": true,
        "lock": true
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": { "root": "packages/tf-app/envs/dev" },
        "prod": { "root": "packages/tf-app/envs/prod" }
      }
    },
    "validate": {
      "executor": "@nx-extend/terraform:validate",
      "options": {
        "ciMode": true
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": { "root": "packages/tf-app/envs/dev" },
        "prod": { "root": "packages/tf-app/envs/prod" }
      }
    },
    "plan": {
      "executor": "@nx-extend/terraform:plan",
      "options": {
        "planFile": "defaultplan",
        "ciMode": true
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": { "root": "packages/tf-app/envs/dev" },
        "prod": { "root": "packages/tf-app/envs/prod" }
      }
    },
    "apply": {
      "executor": "@nx-extend/terraform:apply",
      "options": {
        "planFile": "defaultplan",
        "ciMode": true,
        "autoApproval": false
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": { "root": "packages/tf-app/envs/dev" },
        "prod": { "root": "packages/tf-app/envs/prod" }
      }
    },
    "destroy": {
      "executor": "@nx-extend/terraform:destroy",
      "options": {
        "ciMode": true,
        "autoApproval": false
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": { "root": "packages/tf-app/envs/dev" },
        "prod": { "root": "packages/tf-app/envs/prod" }
      }
    },
    "fmt": {
      "executor": "@nx-extend/terraform:fmt",
      "options": {
        "ciMode": true,
        "formatWrite": false,
        "root": "packages/tf-app"
      }
    }
  },
  "tags": []
}
