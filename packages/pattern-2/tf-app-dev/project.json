{
  "name": "pattern-2-tf-app-dev",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/pattern-2/tf-app-dev/stack",
  "tags": [],
  "targets": {
    "plan": {
      "executor": "@nx-extend/terraform:plan",
      "options": {
        "planFile": "defaultplan",
        "ciMode": true,
        "varFile": "../terraform.tfvars"
      }
    },
    "initialize": {
      "executor": "@nx-extend/terraform:init",
      "options": {
        "ciMode": true,
        "upgrade": false,
        "migrateState": false
      }
    },
    "providers": {
      "executor": "@nx-extend/terraform:providers",
      "options": {
        "ciMode": true,
        "lock": true
      }
    },
    "fmt": {
      "executor": "@nx-extend/terraform:fmt",
      "options": {
        "ciMode": true,
        "formatWrite": false,
        "root": "packages/pattern-2/tf-app-dev"
      }
    },
    "apply": {
      "executor": "@nx-extend/terraform:apply",
      "options": {
        "planFile": "defaultplan",
        "ciMode": true,
        "autoApproval": false
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "terraform destroy -var-file=../terraform.tfvars",
        "cwd": "packages/pattern-2/tf-app-dev/stack"
      }
    },
    "validate": {
      "executor": "@nx-extend/terraform:validate",
      "options": {
        "ciMode": true
      }
    }
  }
}
